# OPIE uses Claude vision (Anthropic) for OCR + attribute extraction.
# The pipeline runs in OFFLINE mode (local Tesseract + heuristic parser) until a
# key is present, so tests pass with no credentials. Add a key to get real,
# measured extraction metrics.
#
# Copy to .env and fill in, or export in your shell, or use `ant auth login`.

# ANTHROPIC_API_KEY=sk-ant-...

# Which backend the pipeline uses: "anthropic" (Claude vision) or "offline".
# Defaults to "anthropic" when a credential is available, else "offline".
# OPIE_BACKEND=anthropic

# Model for the vision/extraction + validation agents.
# OPIE_MODEL=claude-opus-4-8
